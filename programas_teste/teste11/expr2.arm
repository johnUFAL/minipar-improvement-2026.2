.global _start
.text
_start:
    MOV    r0, #10
    MOV    r1, #8
    MOV    r2, #7
    MUL    r3, r1, r2    @ resultado de '(8 * 7)'
    SUB    r4, r0, r3    @ resultado de '(10 - (8 * 7))'
    MOV    r5, #4
    ADD    r6, r4, r5    @ resultado de '((10 - (8 * 7)) + 4)'
    MOV    r7, #2
    MUL    r8, r6, r7    @ resultado de '(((10 - (8 * 7)) + 4) * 2)'
    b .    @ loop infinito para parar o programa
