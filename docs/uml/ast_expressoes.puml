@startuml ast_expressoes
title MiniPar - AST: valores e operadores

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

class ASTNode <<dataclass, frozen>> {
  +line : int = 1
  +column : int = 1
  +tipo_inferido : str | None = None
}

class NumberExpr <<dataclass, frozen>> {
  +value : str = ""
}
class StringExpr <<dataclass, frozen>> {
  +value : str = ""
}
class BoolExpr <<dataclass, frozen>> {
  +value : bool = false
}
class IdentifierExpr <<dataclass, frozen>> {
  +name : str = ""
}
class BinaryExpr <<dataclass, frozen>> {
  +op : str = ""
  +left : ASTNode | None
  +right : ASTNode | None
}
class UnaryExpr <<dataclass, frozen>> {
  +op : str = ""
  +operand : ASTNode | None
}

ASTNode <|-- NumberExpr
ASTNode <|-- StringExpr
ASTNode <|-- BoolExpr
ASTNode <|-- IdentifierExpr
ASTNode <|-- BinaryExpr
ASTNode <|-- UnaryExpr

note bottom of ASTNode
  A AST nao tem classes intermediarias Expr ou Stmt;
  AttributeDecl e MethodDecl especializam VarDecl e FuncDecl.
end note
@enduml
