@startuml componentes
title MiniPar 2026.2 - Diagrama de Componentes

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #555555
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam interface {
  BackgroundColor #FFF3C4
  BorderColor #8A6D00
}
left to right direction

' Notacao:
'   Iface - Comp        = interface PROVIDA (lollipop)
'   Comp ..> Iface      = interface REQUERIDA (socket / dependencia)

' ---------------------------------------------------------------
' Cliente do compilador (fora do modelo de componentes do compilador)
' ---------------------------------------------------------------
component "CompiladorMiniPar\n(components/compilador.py)\nponto de entrada + leitura de arquivo" as Compilador #E8F0FE

' ---------------------------------------------------------------
' Compilador
' ---------------------------------------------------------------
package "Compilador MiniPar (components/)" {

  interface IControle
  interface ILexico
  interface ISintatico
  interface ISemantico
  interface ITabelaSimbolos
  interface IGeradorTAC
  interface IGeradorCpp

  component "CControle\n(c_controle.py)" as Controle
  component "CLexico\n(c_lexico.py)" as Lexico
  component "CSintatico\n(c_sintatico.py)" as Sintatico
  component "CSemantico\n(c_semantico.py)" as Semantico
  component "CTabelaSimbolos\n(c_tabela_simbolos.py)" as TabelaSimbolos
  component "CGeradorTAC\n(c_gerador_tac.py)\ncodigo de 3 enderecos" as GeradorTAC #D5F5E3

  component "CGeradorCpp\n(c_gerador_cpp.py)\ncodigo C++20" as GeradorCpp #D5F5E3 {
    component "Driver GCC\n(driver_gcc.py)" as DriverGCC
  }

  ' --- interfaces PROVIDAS ---
  IControle       - Controle
  ILexico         - Lexico
  ISintatico      - Sintatico
  ISemantico      - Semantico
  ITabelaSimbolos - TabelaSimbolos
  IGeradorTAC     - GeradorTAC
  IGeradorCpp     - GeradorCpp

  ' --- interfaces REQUERIDAS ---
  Sintatico ..> ILexico         : requer
  Sintatico ..> ISemantico      : requer
  Semantico ..> ITabelaSimbolos : requer

  Controle  ..> ILexico         : requer
  Controle  ..> ISintatico      : requer
  Controle  ..> ISemantico      : requer
  Controle  ..> IGeradorTAC     : requer
  Controle  ..> IGeradorCpp     : requer

  ' Driver e detalhe interno do gerador C++ (sem interface propria em interfaces.py)
  GeradorCpp --> DriverGCC : invoca g++
}

Compilador ..> IControle : requer

' ---------------------------------------------------------------
' Fora do compilador: runtime e rede, ligados ao binario gerado
' ---------------------------------------------------------------
package "Runtime C++ (runtime/) - fora do compilador" #F4ECF7 {
  component "Paralelismo\n(paralelo.cpp)\nminipar_parallel -> std::thread" as RTParalelo
  component "Rede / Canal TCP\n(canal.cpp)\nMiniParChannel: send/receive" as RTRede
  component "minipar_rt.hpp\n(helpers: input, matrix, range...)" as RTHeader
}

DriverGCC ..> RTParalelo : compila e linka
DriverGCC ..> RTRede     : compila e linka
DriverGCC ..> RTHeader   : -I runtime/

node "Outro computador\n(c_channel IP:porta)" as Remoto
RTRede ..> Remoto : sockets TCP

legend right
  <b>Fluxo de dados</b>
  1. Fonte .mp -> (CompiladorMiniPar le o arquivo) -> texto
  2. CLexico   -> <b>Tokens</b> (Token, imutavel) -> CSintatico
  3. CSintatico -> <b>AST</b> (Program) -> CSemantico (+ Tabela de Simbolos)
  4. AST validada -> CGeradorTAC -> <b>TAC</b> (arquivo .tac)
  5. AST validada -> CGeradorCpp -> <b>codigo C++</b> (.cpp) -> Driver GCC -> binario
  6. Binario + runtime -> execucao (threads locais / canais TCP)
  Erros: Diagnostico(fase, mensagem, linha, coluna)

  <b>Notacao</b>
  Pirulito (-)  = interface provida
  Seta tracejada = interface requerida
  Verde = geradores exigidos pelo Anexo 1
end legend

@enduml
